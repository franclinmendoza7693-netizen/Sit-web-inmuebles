# Copia este archivo como .env y completa tus datos locales.
PORT=3000

# Base de datos: MariaDB de XAMPP (módulo "MySQL" del panel de XAMPP)
# Usar 127.0.0.1 (no "localhost") evita problemas de IPv6 en Windows.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# En XAMPP, root viene SIN contraseña: déjalo vacío salvo que le hayas puesto una.
DB_PASSWORD=
DB_NAME=inmo_predict

JWT_SECRET=cambia_esto_por_una_frase_larga_y_secreta
JWT_EXPIRA=2h
